# Build output. Regenerated by `npm run build`; committing it would let the
# repository and the image disagree about what the service actually runs.
dist/

# node_modules is already ignored by the repository root's .gitignore (the
# pattern matches at any depth), listed here so this directory is self-contained
# if it is ever extracted into its own repository.
node_modules/

.env
.env.local

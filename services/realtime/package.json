{
  "name": "@lms/realtime",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Socket.io service for Code Queens Hub live-class chat, Q&A and presence. Deployed separately from the Next.js app.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {

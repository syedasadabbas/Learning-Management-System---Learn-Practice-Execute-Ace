# Copy to .env and fill in. Never commit .env — it is gitignored.

# ---------------------------------------------------------------------------
# Neon Postgres. Use the POOLED connection string (the host contains "-pooler").
# src/db/index.ts connects with node-postgres over the standard wire protocol,
# so PgBouncer on that endpoint absorbs serverless connection churn.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5). Generate with: openssl rand -base64 32
# The schema has no sessions/accounts tables, so the JWT session strategy is
# required — there is no database adapter to fall back on.
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-with-32-plus-char-random-string"

# App URL. Vercel sets this automatically in production.
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Shared secret for the Google Sheet ingestion endpoint
# (POST /api/assignments/:assignmentId/ingest). That route WRITES submission
# rows, so it is server-to-server only — see ROUTE_AUTH in
# src/lib/contracts/api.ts, where it is marked "cron".
# Generate with: openssl rand -base64 32
# ---------------------------------------------------------------------------
CRON_SECRET="replace-with-32-plus-char-random-string"

# ---------------------------------------------------------------------------
# Piston — the sandboxed code-execution backend behind POST /api/execute, the
# coding-problem grader (src/lib/execution/piston.ts) and the grand-quiz
# service. OPTIONAL.
#
# Unset defaults to the FREE PUBLIC instance at https://emkc.org/api/v2/piston,
# which is shared infrastructure with a rate limit and no SLA — the same caveat
# as meet.jit.si further down. Set this to point at a self-hosted Piston.
#
# NOTE: the presence or absence of this variable is deliberately NOT used as the
# "is server grading available" signal (see src/lib/problems/availability.ts) —
# it has a default, so it is always effectively present.
# ---------------------------------------------------------------------------
# PISTON_URL="https://emkc.org/api/v2/piston"

# ---------------------------------------------------------------------------
# Password-reset email (account stream). ALL OPTIONAL — leaving these unset is
# the DEFAULT and supported state: the mailer falls back to a dev transport that
# logs the reset link to the server console instead of sending it. Nothing
# crashes and no request 500s when SMTP is absent.
#
# FREE_STACK.md: this is the ORGANISATION'S OWN free mailbox over plain SMTP
# (e.g. a Gmail account with an app password). There is no paid email API and no
# third-party key — Resend was dropped for exactly that reason.
#
# SMTP_HOST is the single switch: with no host there is nothing to connect to, so
# the dev transport is used regardless of the other variables.
#
# NOTE: sending requires the `nodemailer` package, which is NOT yet in
# package.json (that file is outside the account stream's ownership). Until it is
# added, setting SMTP_HOST logs "transport_unavailable" and falls back to the dev
# transport rather than failing the request. Install with: npm install nodemailer
# ---------------------------------------------------------------------------
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"                  # 587 = STARTTLS, 465 = implicit TLS
# SMTP_SECURE="false"              # defaults to true only when SMTP_PORT is 465
# SMTP_USER="lms@your-domain.test"
# SMTP_PASSWORD="app-password-not-your-account-password"
# SMTP_FROM="Code Queens LMS <lms@your-domain.test>"   # defaults to SMTP_USER

# If SMTP is configured but a send fails, the reset link is written to the server
# log so an operator can still recover it. Set to "false" to suppress that
# fallback and lose the link instead.
# MAIL_LOG_FALLBACK="true"

# ---------------------------------------------------------------------------
# Google Form / Sheet delivery and ingestion (submissions stream). ALL OPTIONAL.
#
# READ THIS BEFORE A COHORT IS ENROLLED. Every seeded assignment had NULL in
# `assignments.google_form_url` and `google_sheet_csv_url`, so the pipeline
# delivered nothing and ingested nothing. The seeder now fills both in — but with
# a LOCAL STAND-IN, not with Google, because a Google Form cannot be created from
# this repository. See src/lib/submissions/stand-in.ts.
#
# TODO(course-owner): create one Google Form per week, publish its linked
# response sheet (File -> Share -> Publish to web -> comma-separated values), and
# set the pair below for each week. Anything set here WINS over the stand-in, and
# the seeder never overwrites a URL that is already in the database — so the
# admin console (Admin -> Assignments) is an equally valid place to set them.
# Keyed by week NUMBER, which survives a reseed; assignment ids do not.
# ---------------------------------------------------------------------------
# SUBMISSIONS_FORM_URL_WEEK_1="https://docs.google.com/forms/d/e/XXXX/viewform"
# SUBMISSIONS_SHEET_CSV_URL_WEEK_1="https://docs.google.com/spreadsheets/d/e/XXXX/pub?output=csv"
# ... and the same pair for WEEK_2, WEEK_3, WEEK_4.

# Origin the stand-in URLs are built against. Defaults to NEXTAUTH_URL, then to
# http://localhost:3000. Only needed for a preview deployment on another origin.
# SUBMISSIONS_STAND_IN_BASE_URL="http://localhost:3000"

# The stand-in response-sheet endpoint 404s in a production build. Set to "1" to
# force it on for a staging demo. Do NOT set it on a host students can reach: it
# serves a seeded demo student's address with no authentication, by necessity —
# ingestion fetches it server-side with no cookies.
# SUBMISSIONS_STAND_IN_SHEET="1"

# Where the stand-in submission page tells students to email their work while
# there is no Form. Defaults to the seeded instructor account, whose .test domain
# does not deliver anywhere.
# SUBMISSIONS_INSTRUCTOR_EMAIL="instructor@your-domain.test"

# ===========================================================================
# ADD-ON WAVE FEATURE FLAGS — learning enhancements, live classes, presentations
# ===========================================================================
# Read by src/lib/features.ts. Parsed STRICTLY: only the exact string "true"
# enables a feature. Not "1", not "TRUE", not "yes". Unset means OFF, and every
# flag below is unset by default on purpose — a preview deployment nobody
# configured must behave exactly like the LMS did before this wave landed.
#
# Each feature has TWO vars. The unprefixed one gates the API routes and server
# components; the NEXT_PUBLIC_ one gates the client components and is inlined at
# BUILD time. SET THEM TO THE SAME VALUE. Setting only the server var leaves the
# UI hidden while the endpoints answer; setting only the public var renders a UI
# whose every request 404s.

# Sample implementations, practice problems, interview questions, concept
# visualizations. Purely additive read-only surfaces over existing lectures and
# assignments — no external dependency, safe to enable first.
# LEARNING_ENHANCEMENTS_ENABLED="true"
# NEXT_PUBLIC_LEARNING_ENHANCEMENTS_ENABLED="true"

# Slide builder, presenter view, Reveal.js viewer, PDF/HTML export. Entirely
# client-side; no external service. Independent of live classes on purpose.
# PRESENTATIONS_ENABLED="true"
# NEXT_PUBLIC_PRESENTATIONS_ENABLED="true"

# Scheduling, class room, Jitsi embed, attendance, chat, Q&A. This is the ONLY
# feature with an out-of-process dependency. Leave it off until the realtime
# service below is deployed and reachable.
# LIVE_CLASSES_ENABLED="true"
# NEXT_PUBLIC_LIVE_CLASSES_ENABLED="true"

# ---------------------------------------------------------------------------
# Jitsi (video plane for live classes)
# ---------------------------------------------------------------------------
# Defaults to the free public meet.jit.si when unset. That deployment is shared
# infrastructure with NO SLA and no retention guarantee — do not treat a session
# held on it as private or as durably recorded.
#
# Self-hosting on Railway is NOT possible: Jitsi's videobridge needs UDP/10000
# ingress and Railway routes HTTP/TCP only. A self-hosted deployment needs a VPS
# with a public UDP port; 8x8 JaaS is the managed alternative. Either way the
# swap is this one variable.
# NEXT_PUBLIC_JITSI_DOMAIN="meet.jit.si"

# ---------------------------------------------------------------------------
# Realtime service (chat / Q&A text plane for live classes)
# ---------------------------------------------------------------------------
# Base URL of the standalone Socket.io service in services/realtime/. Vercel
# serverless functions cannot hold WebSocket connections, so this runs on a
# separate host (Railway, Fly.io or Render — see DEPLOYMENT_LIVE_CLASSES.md).
#
# UNSET IS A SUPPORTED STATE. With no URL the chat and Q&A panels fall back to
# read-only history over REST; video, attendance and the class itself still
# work. A live class must not fail because a hobby dyno went to sleep.
# NEXT_PUBLIC_REALTIME_URL="https://your-service.up.railway.app"

# Shared secret the Next app and the realtime service both hold. The service
# uses it to verify that a socket handshake token was minted by this app rather
# than forged by a client. Generate with: openssl rand -base64 32
# REALTIME_SHARED_SECRET=""
